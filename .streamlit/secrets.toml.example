# Copy to .streamlit/secrets.toml (never commit that file), or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets.
# Every setting is optional. This example runs the public demo.

# Locks phase and data-source settings and keeps visitors' corrections private.
DEMO_MODE = true

# Fixed admin PIN. When set, the PIN can't be changed in the app.
ADMIN_PIN = "2468"

# LIVE deployments only: save phases, name corrections, uploaded master
# lists and the admin PIN in MongoDB Atlas instead of local files. Ignored
# when DEMO_MODE is true, so the demo can never touch live data.
# MONGODB_URI = "mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB = "nrbc_dashboard"

# IANA time zone for the "today" defaults.
# REPORTING_TIMEZONE = "Africa/Blantyre"

# First phase, created when the app has none (survives restarts on hosts
# that reset local files). Links can be Google Sheets shared as "Anyone
# with the link can view", or .csv files inside the project folder.
[initial_phase]
office_name = "Lakeside District Registration Office (Demo)"
title = "Birth and ID registration outreach, phase 1"
start_date = "2026-07-06"
end_date = "2026-07-15"
response_sheet_url = "examples/demo/responses.csv"
master_sheet_url = "examples/demo/master_list.csv"
